# Set these in Vercel → Settings → Environment Variables
# (and locally in .env.local for `npm run dev`)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — server-side only, NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Shared secret between the EA and the receiver.
# Must match Inp_AuthToken in the Telemetry EA inputs.
INGEST_TOKEN=pick-a-long-random-string

# Prune snapshots older than this many days (every Nth push). Set to 0 to disable.
PRUNE_EVERY_N_PUSHES=200
